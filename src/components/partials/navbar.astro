---
import { navIds, type Dictionary, type AppLocale } from "@/common/i18n";
import Brand from "@/components/ui/brand.astro";
interface Props { t: Dictionary; lang: AppLocale }
const { t, lang } = Astro.props;
---
<header class="masthead">
  <nav class="wrap nav-row" aria-label={t.ui.nav}>
    <Brand />
    <div class="nav-links">{navIds.map((id, i) => <a href={`#${id}`}>{t.nav[i]}</a>)}</div>
    <div class="nav-tools">
      <div class="languages" aria-label={t.ui.language}>
        {(["en","id"] as const).map(code => <a href={`/${code}/`} lang={code} hreflang={code} aria-label={code === "en" ? "English" : "Bahasa Indonesia"} aria-current={lang === code ? "page" : undefined}>{code.toUpperCase()}</a>)}
      </div>
      <a href="#download" class="btn primary nav-download">{t.ui.download}</a>
      <details class="menu">
        <summary aria-label={t.ui.menu}><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="2" /></svg></summary>
        <div class="menu-panel">{navIds.map((id, i) => <a href={`#${id}`}>{t.nav[i]}</a>)}<a href="#download">{t.ui.preview}</a></div>
      </details>
    </div>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".menu")!;
  document.addEventListener("click", event => {
    const target = event.target;
    if (target instanceof Element && (!menu.contains(target) || target.closest("a"))) menu.open = false;
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  function updateLocaleLinks() {
    document.querySelectorAll<HTMLAnchorElement>(".languages a").forEach(link => { link.hash = location.hash; });
  }
  updateLocaleLinks();
  window.addEventListener("hashchange", updateLocaleLinks);
</script>
