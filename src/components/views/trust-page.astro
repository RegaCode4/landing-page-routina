---
import type { TrustPage } from "@/common/trust-pages";
interface Props { page: TrustPage }
const { page } = Astro.props;
---
<main id="main" class="content-page">
  <article>
    <header class="content-header">
      <p class="eyebrow">{page.label}</p>
      <h1>{page.title}</h1>
      <p class="intro">{page.intro}</p>
      <p class="page-date"><time datetime="2026-11-19">{page.updated}</time></p>
    </header>
    {page.sections.map(section => <section>
      <h2>{section.title}</h2>
      {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      {section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
    </section>)}
    <div class="page-actions">{page.actions.map((action, index) => <a class={`btn ${index === 0 ? "primary" : "outline"}`} href={action.href}>{action.label}</a>)}</div>
  </article>
</main>
