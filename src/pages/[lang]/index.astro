---
import { locales, dictionaries } from "@/common/i18n";
import Base from "@/layouts/base.astro";
import Navbar from "@/components/partials/navbar.astro";
import Footer from "@/components/partials/footer.astro";
import Hero from "@/components/views/hero.astro";
import Features from "@/components/views/features.astro";
import Activity from "@/components/views/activity.astro";
import Gallery from "@/components/views/gallery.astro";
import Download from "@/components/views/download.astro";

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const t = dictionaries[lang];
---
<Base {lang} {t}>
  <Navbar {t} {lang} />
  <main id="main">
    <Hero {t} />
    <Features {t} />
    <Activity {t} />
    <Gallery {t} />
    <Download {t} {lang} />
  </main>
  <Footer {t} {lang} />
</Base>
